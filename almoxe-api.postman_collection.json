{
  "info": {
    "name": "Almoxe API",
    "description": "Coleção de endpoints da Almoxe API (auth JWT, catálogo, estoque, máquina de estados, obras, fotos, alerta de estoque baixo).\n\nAUTENTICAÇÃO: rode primeiro 'Autenticação > Login (almoxarife)' — o script salva o JWT na variável {{token}}, usada como Bearer em toda a coleção. Para testar o papel LIDER, rode 'Login (líder)'.\n\nFluxo sugerido (Collection Runner ou de cima para baixo, logado como ALMOXARIFE):\n1. Login (almoxarife)\n2. Categorias > Criar  (captura categoriaId)\n3. Produtos > Criar UNIDADE_UNICA / QUANTIDADE / LOTE\n4. Obras > Criar\n5. Estoque > Entrada (UNIDADE_UNICA / QUANTIDADE)\n6. Estoque > Histórico de movimentações (captura movimentacaoId)\n7. Estoque > Alocar (responsavelId = líder) > Usar > Baixar\n8. Fotos > Upload (selecione um arquivo no campo 'arquivos')\n\nObs.: 'quem registrou' vem do token (não há mais usuarioId no corpo). responsavelId na alocação aponta para o líder que assume o item.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [ { "key": "token", "value": "{{token}}", "type": "string" } ]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "usuarioAlmoxarifeId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "usuarioLiderId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "categoriaId", "value": "" },
    { "key": "produtoId", "value": "" },
    { "key": "produtoQtdId", "value": "" },
    { "key": "produtoLoteId", "value": "" },
    { "key": "obraId", "value": "" },
    { "key": "itemId", "value": "" },
    { "key": "itemQtdId", "value": "" },
    { "key": "movimentacaoId", "value": "" },
    { "key": "fotoId", "value": "" }
  ],
  "item": [
    {
      "name": "Autenticação",
      "item": [
        {
          "name": "Login (almoxarife)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"almoxarife@almoxe.dev\",\n  \"senha\": \"senha123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Login (líder)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ] } }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"lider@almoxe.dev\",\n  \"senha\": \"senha123\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
          }
        },
        {
          "name": "Cadastrar usuário (ALMOXARIFE)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Novo Líder\",\n  \"email\": \"novo.lider@almoxe.dev\",\n  \"senha\": \"senha123\",\n  \"papel\": \"LIDER\"\n}" },
            "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] }
          }
        },
        {
          "name": "Listar usuários",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/usuarios", "host": ["{{baseUrl}}"], "path": ["usuarios"] } }
        },
        {
          "name": "Buscar usuário por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/usuarios/{{usuarioAlmoxarifeId}}", "host": ["{{baseUrl}}"], "path": ["usuarios", "{{usuarioAlmoxarifeId}}"] } }
        }
      ]
    },
    {
      "name": "Categorias",
      "item": [
        {
          "name": "Criar categoria",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('categoriaId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Ferramentas Elétricas\"\n}" },
            "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] }
          }
        },
        {
          "name": "Listar categorias",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/categorias", "host": ["{{baseUrl}}"], "path": ["categorias"] } }
        },
        {
          "name": "Buscar categoria por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["categorias", "{{categoriaId}}"] } }
        },
        {
          "name": "Atualizar categoria",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Ferramentas Elétricas e Manuais\"\n}" },
            "url": { "raw": "{{baseUrl}}/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["categorias", "{{categoriaId}}"] }
          }
        },
        {
          "name": "Deletar categoria",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/categorias/{{categoriaId}}", "host": ["{{baseUrl}}"], "path": ["categorias", "{{categoriaId}}"] } }
        }
      ]
    },
    {
      "name": "Produtos",
      "item": [
        {
          "name": "Criar produto (UNIDADE_UNICA)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('produtoId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Furadeira Bosch GSB 13 RE\",\n  \"descricao\": \"Furadeira de impacto 650W\",\n  \"tipoControle\": \"UNIDADE_UNICA\",\n  \"estoqueMinimo\": 1,\n  \"categoriaId\": \"{{categoriaId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "Criar produto (QUANTIDADE)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('produtoQtdId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Parafuso 6mm\",\n  \"tipoControle\": \"QUANTIDADE\",\n  \"estoqueMinimo\": 500\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "Criar produto (LOTE)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('produtoLoteId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Cimento CP II\",\n  \"tipoControle\": \"LOTE\",\n  \"estoqueMinimo\": 10\n}" },
            "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] }
          }
        },
        {
          "name": "Listar produtos",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/produtos", "host": ["{{baseUrl}}"], "path": ["produtos"] } }
        },
        {
          "name": "Buscar produto por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] } }
        },
        {
          "name": "Atualizar produto",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Furadeira Bosch GSB 13 RE\",\n  \"descricao\": \"Furadeira de impacto 650W (revisada)\",\n  \"tipoControle\": \"UNIDADE_UNICA\",\n  \"estoqueMinimo\": 2,\n  \"categoriaId\": \"{{categoriaId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] }
          }
        },
        {
          "name": "Deletar produto",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/produtos/{{produtoId}}", "host": ["{{baseUrl}}"], "path": ["produtos", "{{produtoId}}"] } }
        },
        {
          "name": "Alerta de estoque baixo (ALMOXARIFE)",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/produtos/estoque-baixo", "host": ["{{baseUrl}}"], "path": ["produtos", "estoque-baixo"] } }
        }
      ]
    },
    {
      "name": "Obras",
      "item": [
        {
          "name": "Criar obra",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('obraId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Obra Centro\",\n  \"endereco\": \"Rua A, 100\"\n}" },
            "url": { "raw": "{{baseUrl}}/obras", "host": ["{{baseUrl}}"], "path": ["obras"] }
          }
        },
        {
          "name": "Listar obras",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/obras", "host": ["{{baseUrl}}"], "path": ["obras"] } }
        },
        {
          "name": "Buscar obra por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/obras/{{obraId}}", "host": ["{{baseUrl}}"], "path": ["obras", "{{obraId}}"] } }
        },
        {
          "name": "Atualizar obra",
          "request": {
            "method": "PUT",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Obra Centro - Bloco B\",\n  \"endereco\": \"Rua A, 100\"\n}" },
            "url": { "raw": "{{baseUrl}}/obras/{{obraId}}", "host": ["{{baseUrl}}"], "path": ["obras", "{{obraId}}"] }
          }
        },
        {
          "name": "Deletar obra (soft delete)",
          "request": { "method": "DELETE", "header": [], "url": { "raw": "{{baseUrl}}/obras/{{obraId}}", "host": ["{{baseUrl}}"], "path": ["obras", "{{obraId}}"] } }
        }
      ]
    },
    {
      "name": "Estoque & Movimentações",
      "item": [
        {
          "name": "Entrada (UNIDADE_UNICA)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('itemId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": \"{{produtoId}}\",\n  \"quantidade\": 1,\n  \"numeroSerie\": \"SN-0001\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/entrada", "host": ["{{baseUrl}}"], "path": ["itens", "entrada"] }
          }
        },
        {
          "name": "Entrada (QUANTIDADE)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('itemQtdId', pm.response.json().id); }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": \"{{produtoQtdId}}\",\n  \"quantidade\": 1000\n}" },
            "url": { "raw": "{{baseUrl}}/itens/entrada", "host": ["{{baseUrl}}"], "path": ["itens", "entrada"] }
          }
        },
        {
          "name": "Entrada (LOTE)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"produtoId\": \"{{produtoLoteId}}\",\n  \"quantidade\": 200,\n  \"lote\": \"L-2026-05\",\n  \"notaFiscal\": \"NF-9988\",\n  \"numeroRi\": \"RI-555\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/entrada", "host": ["{{baseUrl}}"], "path": ["itens", "entrada"] }
          }
        },
        {
          "name": "Listar itens",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/itens", "host": ["{{baseUrl}}"], "path": ["itens"] } }
        },
        {
          "name": "Buscar item por id",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/itens/{{itemId}}", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}"] } }
        },
        {
          "name": "Histórico de movimentações do item",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "var arr = pm.response.json();",
              "if (Array.isArray(arr) && arr.length > 0) { pm.collectionVariables.set('movimentacaoId', arr[0].id); }"
            ] } }
          ],
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/itens/{{itemId}}/movimentacoes", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}", "movimentacoes"] } }
        },
        {
          "name": "Alocar item ao líder (DISPONIVEL -> ALOCADO)",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"responsavelId\": \"{{usuarioLiderId}}\",\n  \"obraId\": \"{{obraId}}\",\n  \"observacao\": \"Separado para a obra\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/{{itemId}}/alocacao", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}", "alocacao"] }
          }
        },
        {
          "name": "Usar item (ALOCADO -> EM_USO) [logar como líder]",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"observacao\": \"Início de uso em campo\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/{{itemId}}/uso", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}", "uso"] }
          }
        },
        {
          "name": "Retornar item (-> DISPONIVEL) [logar como líder]",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"observacao\": \"Devolvido ao almoxarifado\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/{{itemId}}/retorno", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}", "retorno"] }
          }
        },
        {
          "name": "Baixar item UNIDADE_UNICA (EM_USO -> CONSUMIDO) [líder]",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"observacao\": \"Quebrou em campo\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/{{itemId}}/baixa", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemId}}", "baixa"] }
          }
        },
        {
          "name": "Baixar item QUANTIDADE (baixa parcial) [almoxarife ou líder responsável]",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "body": { "mode": "raw", "raw": "{\n  \"quantidade\": 30,\n  \"obraId\": \"{{obraId}}\",\n  \"observacao\": \"Consumo em obra\"\n}" },
            "url": { "raw": "{{baseUrl}}/itens/{{itemQtdId}}/baixa", "host": ["{{baseUrl}}"], "path": ["itens", "{{itemQtdId}}", "baixa"] }
          }
        }
      ]
    },
    {
      "name": "Fotos",
      "item": [
        {
          "name": "Anexar fotos à movimentação (multipart)",
          "event": [
            { "listen": "test", "script": { "type": "text/javascript", "exec": [
              "if (pm.response.code === 201) { var arr = pm.response.json(); if (Array.isArray(arr) && arr.length > 0) { pm.collectionVariables.set('fotoId', arr[0].id); } }"
            ] } }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "arquivos", "type": "file", "src": [], "description": "Selecione 1 ou mais imagens (jpg/png/webp, até 10MB cada)" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/movimentacoes/{{movimentacaoId}}/fotos", "host": ["{{baseUrl}}"], "path": ["movimentacoes", "{{movimentacaoId}}", "fotos"] }
          }
        },
        {
          "name": "Listar fotos da movimentação",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/movimentacoes/{{movimentacaoId}}/fotos", "host": ["{{baseUrl}}"], "path": ["movimentacoes", "{{movimentacaoId}}", "fotos"] } }
        },
        {
          "name": "Baixar/exibir foto",
          "request": { "method": "GET", "header": [], "url": { "raw": "{{baseUrl}}/fotos/{{fotoId}}", "host": ["{{baseUrl}}"], "path": ["fotos", "{{fotoId}}"] } }
        }
      ]
    }
  ]
}
